    <string name="app_name" translatable="false">Pebble Phone Connect</string>
    <string name="intro">Lets the Phone &amp; SMS watchapp read your contacts, call history and text messages, place calls and send dictated texts. Everything stays between this phone and your watch: the app has no internet access.</string>

