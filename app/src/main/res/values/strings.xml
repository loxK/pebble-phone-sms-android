    <string name="calls_title">3. Call controls (optional)</string>
    <string name="calls_explain">Mute and speaker during a call. Android only allows them once this app is registered as a companion of your watch. This is a permission recorded by Android, not a new Bluetooth connection: the watch stays connected through the Pebble app.</string>
    <string name="calls_ready">Allowed for %1$s.</string>
    <string name="calls_not_paired">Not allowed: the watch can place a call and hang up, but not mute or switch to the speaker.</string>
    <string name="calls_pair">Allow call control</string>
    <string name="calls_pick_watch">Watch</string>
    <string name="calls_no_watch">No paired Pebble found in the Bluetooth settings.</string>
    <string name="calls_pair_failed">Call control not granted: %1$s</string>

    <string name="replies_title">4. Quick replies</string>
    <string name="replies_explain">Offered on the watch next to dictation and emoji, one per line, up to 10. The watch picks changes up the next time the app opens.</string>
    <string name="replies_save">Save</string>
    <string name="replies_saved">Quick replies saved.</string>
